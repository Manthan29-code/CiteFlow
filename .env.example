# ==============================================================================
# CLI Variables (CiteFlow)
# ==============================================================================
GROBID_URL=http://localhost:8070
CROSSREF_MAILTO=
OPENALEX_API_KEY=
REQUEST_TIMEOUT_SECONDS=15
MAX_PDF_SIZE_MB=50
OCR_ENABLED=true
OUTPUT_DIR=./output

# ==============================================================================
# Server Part A: Platform (FastAPI + PostgreSQL + ImageKit)
# ==============================================================================

# ---------- App ----------
APP_ENV=development                 # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173        # comma-separated; never "*"
FORWARDED_ALLOW_IPS=127.0.0.1                   # set to your proxy IP when behind a reverse proxy
TEMP_DIR=./tmp                                  # per-request temp files, removed after use

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg://citegen:citegen@localhost:5432/citegen
DB_POOL_SIZE=5

# ---------- Auth ----------
JWT_SECRET=                                     # REQUIRED. 32+ random characters / hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false                             # MUST be true when APP_ENV=production
COOKIE_SAMESITE=lax                             # lax | strict
COOKIE_DOMAIN=                                  # empty = host-only cookie
ALLOW_REGISTRATION=true
PASSWORD_MIN_LENGTH=10
LOGIN_RATE_LIMIT=5/minute                       # per IP and per email
REGISTER_RATE_LIMIT=10/hour                     # per IP

# ---------- Upload and folder limits ----------
MAX_UPLOAD_MB=25                                # max upload per file in MB
ALLOWED_EXTENSIONS=pdf                          # comma-separated; must have registered handler
USER_STORAGE_QUOTA_MB=500                       # 0 = unlimited
MAX_FOLDER_DEPTH=20
MAX_NAME_LENGTH=120

# ---------- ImageKit (imagekitio SDK) ----------
IMAGEKIT_PRIVATE_KEY=                           # REQUIRED. Server-only private key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id    # REQUIRED
IMAGEKIT_BASE_FOLDER=/citegen                   # flat upload area: <base>/<owner_id>/
SIGNED_URL_EXPIRES_SECONDS=300

# ---------- Storage cleaner ----------
STORAGE_CLEANER_INTERVAL_SECONDS=30
STORAGE_CLEANER_BATCH_SIZE=100
STORAGE_CLEANER_MAX_ATTEMPTS=10
