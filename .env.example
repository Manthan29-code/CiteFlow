# ==============================================================================
# CiteFlow Configuration & Environment Variables
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real credentials.
# Command to copy: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# ==============================================================================
# 1. Database (Supabase PostgreSQL)
# ==============================================================================
# Go to your Supabase Dashboard -> Project Settings -> Database -> Connection string
# Choose "URI" format.

# Option A: Connection Pooler (RECOMMENDED for Supabase cloud - handles IPv4 & IPv6):
# Mode: Session (port 5432) or Transaction (port 6543).
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B: Direct Connection (Port 5432):
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
#
# Note: CiteFlow's async engine automatically converts 'postgresql://' to 'postgresql+psycopg://'.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Database connection pool size (keep at 5-10 for Supabase free tier connection limits)
DB_POOL_SIZE=5

# ==============================================================================
# 2. Authentication & Security
# ==============================================================================
# JWT_SECRET: Secret key used to sign JWT authentication tokens.
# Must be at least 32 random characters.
# Generate one using terminal: openssl rand -hex 32
# Or in Python: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_32_character_random_hex_string

# JWT algorithm for encoding tokens (default: HS256)
JWT_ALGORITHM=HS256

# Access token lifespan in minutes (default: 15 minutes)
ACCESS_TOKEN_MINUTES=15

# Refresh token lifespan in days (default: 7 days)
REFRESH_TOKEN_DAYS=7

# COOKIE_SECURE: Set to 'true' in production (requires HTTPS), 'false' for local development (HTTP)
COOKIE_SECURE=false

# COOKIE_SAMESITE: CSRF protection cookie policy ('lax' or 'strict')
COOKIE_SAMESITE=lax

# COOKIE_DOMAIN: Leave empty for host-only cookies (localhost); set to '.yourdomain.com' in production
COOKIE_DOMAIN=

# Whether new user registration is enabled (true / false)
ALLOW_REGISTRATION=true

# Minimum password length requirement
PASSWORD_MIN_LENGTH=6

# Authentication rate limits to prevent brute-force attacks
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=10/hour

# ==============================================================================
# 3. File Storage (ImageKit)
# ==============================================================================
# CiteFlow stores uploaded PDFs on ImageKit.io.
# Sign up free at https://imagekit.io -> Developer Options -> API Keys

# Private Key from ImageKit dashboard (starts with 'private_...')
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key_here

# URL Endpoint from ImageKit dashboard (e.g. https://ik.imagekit.io/username)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id_here

# Base folder path inside your ImageKit media library
IMAGEKIT_BASE_FOLDER=/citegen

# Expiration time for signed download URLs (in seconds)
SIGNED_URL_EXPIRES_SECONDS=300

# Background cleaner settings for deleting abandoned/orphan files
STORAGE_CLEANER_INTERVAL_SECONDS=30
STORAGE_CLEANER_BATCH_SIZE=100
STORAGE_CLEANER_MAX_ATTEMPTS=10

# Max upload size per PDF file in megabytes (MB)
MAX_UPLOAD_MB=25

# Allowed file extensions for upload (comma-separated)
ALLOWED_EXTENSIONS=pdf

# Storage quota limit per user in MB (500 = 500 MB quota; 0 = unlimited)
USER_STORAGE_QUOTA_MB=500

# Folder hierarchy limits
MAX_FOLDER_DEPTH=20
MAX_NAME_LENGTH=120

# ==============================================================================
# 4. Academic Metadata & External APIs
# ==============================================================================
# CROSSREF_MAILTO: Your email address passed to CrossRef API header.
# CrossRef provides a free 'Polite Pool' with faster response times and higher limits if you provide an email.
CROSSREF_MAILTO=your-email@example.com

# OPENALEX_API_KEY: Optional API key from https://openalex.org (free).
# Leave blank to use the standard OpenAlex public rate limits.
OPENALEX_API_KEY=

# GROBID_URL: Local or cloud Grobid server for fast PDF structure & metadata extraction.
# Run locally via docker: docker run -t --rm -p 8070:8070 lfoppiano/grobid:0.8.1
GROBID_URL=http://localhost:8070

# Request timeout in seconds for metadata queries
REQUEST_TIMEOUT_SECONDS=15

# Max PDF size processed by local parser
MAX_PDF_SIZE_MB=50

# OCR fallback: Extract text from scanned/image PDFs using Tesseract (true / false)
OCR_ENABLED=true

# Local directory where generated .tex and bibliography files are exported
OUTPUT_DIR=./output

# ==============================================================================
# 5. App Server Configuration
# ==============================================================================
# Environment: 'development' or 'production'
APP_ENV=development

# Host interface to bind server
APP_HOST=0.0.0.0

# Port for backend FastAPI server
APP_PORT=8000

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS Allowed Origins: Frontend URL(s) allowed to make API calls (comma-separated; never use "*")
CORS_ALLOW_ORIGINS=http://localhost:5173

# IP addresses permitted when behind a reverse proxy (e.g. Nginx, Caddy, Cloudflare)
FORWARDED_ALLOW_IPS=127.0.0.1

# Temporary scratch directory for per-request file processing
TEMP_DIR=./tmp

# ==============================================================================
# 6. Background Jobs & Concurrency
# ==============================================================================
# Max citation extraction jobs running concurrently on the server
MAX_CONCURRENT_JOBS=4

# Max concurrent jobs allowed per individual user
MAX_ACTIVE_JOBS_PER_USER=3

# Job timeout before considering it hung (in seconds)
JOB_TIMEOUT_SECONDS=300

# Hours to hold jobs waiting for user title confirmation before expiring
INTERRUPT_EXPIRE_HOURS=24

# Days to retain finished jobs in history
JOB_RETENTION_DAYS=30

# Server-Sent Events (SSE) keepalive heartbeat interval
SSE_HEARTBEAT_SECONDS=15

# Provider rate limit concurrency
CROSSREF_MAX_CONCURRENCY=3
OPENALEX_MAX_CONCURRENCY=3

# LangGraph pipeline state checkpointer: 'memory' (default), 'postgres', or 'sqlite'
CHECKPOINTER=memory

# Optional custom database connection for LangGraph checkpointer (leave blank to use DATABASE_URL)
CHECKPOINT_DATABASE_URL=
