# ==============================================================================
# CiteFlow Frontend Environment Configuration
# ==============================================================================
# Note: In Vite, all environment variables exposed to client-side code MUST start
# with the 'VITE_' prefix. Never store secrets, private API keys, or database credentials here.
# ==============================================================================

# API Base URL
# Value: In development when using Vite proxy, use '/api/v1'.
# If connecting directly to local FastAPI server without proxy, use 'http://localhost:8000/api/v1'.
# In production, set to your API domain (e.g. 'https://api.yourdomain.com/api/v1').
VITE_API_BASE_URL=/api/v1

# Development Proxy Target
# Value: 'http://localhost:8000' (used only by vite.config.ts during development to route /api requests)
DEV_PROXY_TARGET=http://localhost:8000

# Application Name
# Value: 'CiteFlow' (or your preferred app display name in header and page title)
VITE_APP_NAME=CiteFlow

# Maximum File Upload Size in Megabytes
# Value: '25' (should match the server's MAX_UPLOAD_MB setting to give immediate feedback before upload)
VITE_MAX_UPLOAD_MB=25

# Allowed File Extensions
# Value: 'pdf' (comma-separated list of extensions permitted for upload, e.g. 'pdf')
VITE_ALLOWED_EXTENSIONS=pdf

# Folder Pagination Page Size
# Value: '100' (number of files and folders fetched per page. Server accepts between 1 and 500)
VITE_PAGE_SIZE=100

# Concurrent Uploads Limit
# Value: '2' (maximum number of files uploaded simultaneously in the upload queue. Recommended: 2-3)
VITE_UPLOAD_CONCURRENCY=2

# Minimum Password Length
# Value: '6' (minimum characters required for user passwords during registration)
VITE_PASSWORD_MIN_LENGTH=6

# Citation Job Polling Initial Interval (milliseconds)
# Value: '2000' (initial polling frequency for active queued/running citation jobs)
VITE_JOB_POLL_INTERVAL_MS=2000

# Citation Job Polling Maximum Backoff Interval (milliseconds)
# Value: '10000' (maximum backoff interval for polling citation status)
VITE_JOB_POLL_MAX_INTERVAL_MS=10000

# Enable Server-Sent Events (SSE) for Real-Time Job Updates
# Value: 'false' (set to 'true' to connect via EventSource to /api/v1/jobs/{id}/events, fallback to polling)
VITE_ENABLE_SSE=false

# Folder Table Active Jobs Reactive Polling Interval (milliseconds)
# Value: '8000' (frequency to poll active/in-progress citation jobs across the folder table)
VITE_ACTIVE_JOBS_POLL_INTERVAL_MS=8000

